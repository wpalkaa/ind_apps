<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="machines" class="pl.edu.ug.cmms.SampleData" factory-method="machines"/>
    <bean id="workOrders" class="pl.edu.ug.cmms.SampleData" factory-method="workOrders"/>

    <bean id="tasks" class="pl.edu.ug.cmms.Tasks"/>

    <bean id="reportRunner" class="pl.edu.ug.cmms.XmlReportJobRunner">
        <constructor-arg ref="tasks"/>
        <constructor-arg ref="machines"/>
        <constructor-arg ref="workOrders"/>
        <constructor-arg value="${cmms.report.ranking-limit:3}"/>
        <constructor-arg value="${cmms.report.file-path:raport.txt}"/>
    </bean>

</beans>